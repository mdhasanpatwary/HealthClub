# ==========================================
# Health Club (হেলথ ক্লাব) — Environment Variables
# ==========================================

# ------------------------------------------
# 1. Database Connection (PostgreSQL / Supabase)
# ------------------------------------------
# Connection string with connection pooling (Supavisor / PgBouncer on transaction mode port 6543)
# CRITICAL: Always use port 6543 with ?pgbouncer=true in production serverless runtimes to prevent connection exhaustion
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection string reserved solely for Prisma CLI / migrations / seed (session mode port 5432)
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Optional: PostgreSQL pool size per serverless container (defaults to 2 in production, 10 in development)
# PG_MAX_POOL_SIZE="2"

# ------------------------------------------
# 2. Application Core & Base URLs
# ------------------------------------------
# Public canonical base URL of the deployment
NEXT_PUBLIC_APP_URL="https://healthclubfeni.vercel.app"

# Session JWT Secret (Generate with: openssl rand -base64 32)
SESSION_SECRET="your-32-char-random-secret-key-change-in-production"

# Primary Admin Email
ADMIN_EMAIL="healthclubfeni@gmail.com"
NEXT_PUBLIC_ADMIN_EMAIL="healthclubfeni@gmail.com"

# ------------------------------------------
# 3. SMTP Email Configuration (Nodemailer / Gmail)
# ------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="healthclubfeni@gmail.com"
SMTP_PASSWORD="your-16-character-gmail-app-password"

# ------------------------------------------
# 4. Web Push Notifications (PWA / VAPID)
# ------------------------------------------
# Generate with: npx web-push generate-vapid-keys (auto-generated in DB if missing)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-public-vapid-key"
VAPID_PRIVATE_KEY="your-private-vapid-key"
VAPID_SUBJECT="mailto:healthclubfeni@gmail.com"

# ------------------------------------------
# 5. SMS Gateway (Bangladeshi SMS Aggregator)
# ------------------------------------------
# When empty or placeholder, the platform runs in automated SMS Simulation Mode
SMS_API_KEY="your-sms-api-key"
SMS_SENDER_ID="HealthClub"
SMS_API_URL="https://api.sms-provider.com/api/v2/SendSMS"

# ------------------------------------------
# 6. Analytics & Search Engine Verification
# ------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-HXNSQ13G5X"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="your-google-search-console-verification-token"
GOOGLE_SITE_VERIFICATION="your-google-search-console-verification-token"

# ------------------------------------------
# 7. Social Media & External Integrations
# ------------------------------------------
NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/profile.php?id=61591616953090"

# ------------------------------------------
# 8. Supabase Realtime (Optional)
# ------------------------------------------
# If configured, client-side connects to Supabase Realtime channels.
# If omitted or offline, the app automatically uses the built-in Next.js SSE Realtime engine.
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

