generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider  = "postgresql"
}

model Member {
  id                String        @id
  name              String
  phone             String        @unique
  email             String?       @unique
  password          String
  tier              String        // 'founding' | 'premium'
  status            String        // 'active' | 'inactive'
  joinedDate        DateTime      @map("joined_date") @db.Date
  expiryDate        DateTime      @map("expiry_date") @db.Date
  qrCodeUrl         String?       @map("qr_code_url")
  totalSaved        Int           @default(0) @map("total_saved")
  address           String?
  birthDate         DateTime?     @map("birth_date") @db.Date
  profession        String?
  profilePictureUrl String?       @map("profile_picture_url")
  emailVerified     Boolean       @default(false) @map("email_verified")
  verificationCode  String?       @map("verification_code")
  verificationCodeCreatedAt DateTime?     @map("verification_code_created_at") @db.Timestamptz
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  bkashSender       String?       @map("bkash_sender")
  bkashTxnId        String?       @map("bkash_txn_id")
  renewalStatus     String?       @default("none") @map("renewal_status")
  renewalBkashSender String?      @map("renewal_bkash_sender")
  renewalBkashTxnId  String?      @map("renewal_bkash_txn_id")
  transactions      Transaction[]

  @@map("members")
}

model Partner {
  id                        String        @id
  name                      String
  category                  String        // 'hospital' | 'diagnostic' | 'pharmacy'
  address                   String
  discount                  String
  phone                     String
  email                     String?       @unique
  password                  String?
  logoText                  String        @map("logo_text")
  mapLink                   String?       @map("map_link")
  imageUrl                  String?       @map("image_url")
  verificationCode          String?       @map("verification_code")
  verificationCodeCreatedAt DateTime?     @map("verification_code_created_at") @db.Timestamptz
  createdAt                 DateTime      @default(now()) @map("created_at") @db.Timestamptz
  transactions              Transaction[]

  @@map("partners")
}

model Transaction {
  id          String   @id
  memberId    String   @map("member_id")
  memberName  String   @map("member_name")
  partnerId   String   @map("partner_id")
  partnerName String   @map("partner_name")
  amount      Int
  saved       Int
  date        DateTime @default(now()) @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model PartnerRequest {
  id          String   @id
  orgName     String   @map("org_name")
  category    String   // 'hospital' | 'diagnostic' | 'pharmacy'
  address     String
  discount    String
  phone       String
  email       String?
  status      String   @default("pending") // 'pending' | 'approved' | 'rejected'
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("partner_requests")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  phone     String
  email     String?
  message   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("contact_messages")
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("system_settings")
}



