generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider  = "postgresql"
}

model Member {
  id                String        @id
  name              String
  phone             String        @unique
  email             String?       @unique
  password          String
  tier              String        // 'founding' | 'premium'
  status            String        // 'active' | 'inactive'
  joinedDate        DateTime      @map("joined_date") @db.Date
  expiryDate        DateTime      @map("expiry_date") @db.Date
  qrCodeUrl         String?       @map("qr_code_url")
  totalSaved        Int           @default(0) @map("total_saved")
  address           String?
  birthDate         DateTime?     @map("birth_date") @db.Date
  profession        String?
  profilePictureUrl String?       @map("profile_picture_url")
  emailVerified     Boolean       @default(false) @map("email_verified")
  verificationCode  String?       @map("verification_code")
  verificationCodeCreatedAt DateTime?     @map("verification_code_created_at") @db.Timestamptz
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  bkashSender       String?       @map("bkash_sender")
  bkashTxnId        String?       @map("bkash_txn_id")
  renewalStatus     String?       @default("none") @map("renewal_status")
  renewalBkashSender String?      @map("renewal_bkash_sender")
  renewalBkashTxnId  String?      @map("renewal_bkash_txn_id")
  transactions      Transaction[]
  notifications     MemberNotification[]
  reviews           Review[]

  // Indexes for frequent filter/sort patterns
  @@index([status])
  @@index([tier])
  @@index([renewalStatus], map: "members_renewal_status_idx")
  @@index([expiryDate], map: "members_expiry_date_idx")
  @@index([createdAt(sort: Desc)], map: "members_created_at_idx")
  @@map("members")
}

model Partner {
  id                        String        @id
  name                      String
  category                  String        // 'hospital' | 'diagnostic' | 'pharmacy'
  address                   String
  discount                  String
  phone                     String
  email                     String?       @unique
  password                  String?
  logoText                  String        @map("logo_text")
  mapLink                   String?       @map("map_link")
  imageUrl                  String?       @map("image_url")
  emergencyPhone            String?       @map("emergency_phone")
  workingHours              String?       @map("working_hours")
  departmentDiscounts       String?       @map("department_discounts")
  upazila                   String?       @default("feni-sadar") @map("upazila")
  verificationCode          String?       @map("verification_code")
  verificationCodeCreatedAt DateTime?     @map("verification_code_created_at") @db.Timestamptz
  createdAt                 DateTime      @default(now()) @map("created_at") @db.Timestamptz
  transactions              Transaction[]
  doctors                   Doctor[]
  staff                     PartnerStaff[]
  reviews                   Review[]

  @@index([category])
  @@index([upazila], map: "partners_upazila_idx")
  @@map("partners")
}

model PartnerStaff {
  id           String        @id
  partnerId    String        @map("partner_id")
  name         String
  username     String        @unique
  phone        String?
  deskName     String        @map("desk_name") // e.g. "Counter 1 - Billing", "Pharmacy Desk"
  password     String
  role         String        @default("cashier") // 'cashier' | 'manager'
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  transactions Transaction[]

  partner      Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId], map: "partner_staff_partner_id_idx")
  @@index([isActive], map: "partner_staff_is_active_idx")
  @@index([createdAt(sort: Desc)], map: "partner_staff_created_at_idx")
  @@map("partner_staff")
}

model Transaction {
  id          String   @id
  memberId    String   @map("member_id")
  memberName  String   @map("member_name")
  partnerId   String   @map("partner_id")
  partnerName String   @map("partner_name")
  staffId     String?  @map("staff_id")
  staffName   String?  @map("staff_name")
  deskName    String?  @map("desk_name")
  amount      Int
  saved       Int
  date        DateTime @default(now()) @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  member  Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  partner Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  staff   PartnerStaff? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  // Indexes for frequent filter/sort patterns
  @@index([memberId], map: "transactions_member_id_idx")
  @@index([partnerId], map: "transactions_partner_id_idx")
  @@index([staffId], map: "transactions_staff_id_idx")
  @@index([createdAt(sort: Desc)], map: "transactions_created_at_idx")
  @@map("transactions")
}

model Doctor {
  id              String   @id
  name            String
  specialty       String
  department      String   // 'medicine' | 'cardiology' | 'gynecology' | 'orthopedics' | 'neurology' | 'pediatrics' | 'surgery' | 'dermatology' | 'ent' | 'eye' | 'psychiatry' | 'nephrology' | 'hepatology' | 'rheumatology' | 'nutrition' | 'dental' | 'other'
  degrees         String
  designation     String
  chamberName     String   @map("chamber_name")
  chamberAddress  String   @map("chamber_address")
  roomNo          String?  @map("room_no")
  visitingDays    String   @map("visiting_days")
  visitingHours   String   @map("visiting_hours")
  serialPhone     String   @map("serial_phone")
  consultationFee String?  @map("consultation_fee")
  imageUrl        String?  @map("image_url")
  partnerId       String?  @map("partner_id")
  upazila         String?   @default("feni-sadar") @map("upazila")
  isActive        Boolean   @default(true) @map("is_active")
  availableToday  Boolean   @default(true) @map("available_today")
  onLeaveUntil    DateTime? @map("on_leave_until") @db.Date
  notice          String?   @map("notice")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  partner         Partner?  @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([department], map: "doctors_department_idx")
  @@index([upazila], map: "doctors_upazila_idx")
  @@index([isActive], map: "doctors_is_active_idx")
  @@index([partnerId], map: "doctors_partner_id_idx")
  @@index([availableToday], map: "doctors_available_today_idx")
  @@map("doctors")
}

model PartnerRequest {
  id          String   @id
  orgName     String   @map("org_name")
  category    String   // 'hospital' | 'diagnostic' | 'pharmacy'
  address     String
  discount    String
  contactName String?  @map("contact_name")
  phone       String
  email       String?
  status      String   @default("pending") // 'pending' | 'approved' | 'rejected'
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([status], map: "partner_requests_status_idx")
  @@map("partner_requests")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  phone     String
  email     String?
  message   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("contact_messages")
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("system_settings")
}

model PwaInstallation {
  id              String   @id
  userId          String?  @map("user_id")
  platform        String
  browser         String?
  deviceType      String?  @map("device_type")
  isStandalone    Boolean  @default(false) @map("is_standalone")
  installedAt     DateTime @default(now()) @map("installed_at") @db.Timestamptz
  lastActiveAt    DateTime @default(now()) @map("last_active_at") @db.Timestamptz
  promptShown     Int      @default(0) @map("prompt_shown")
  promptDismissed Int      @default(0) @map("prompt_dismissed")
  promptAccepted  Int      @default(0) @map("prompt_accepted")
  sessionCount    Int      @default(1) @map("session_count")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([isStandalone], map: "pwa_installations_is_standalone_idx")
  @@index([lastActiveAt(sort: Desc)], map: "pwa_installations_last_active_idx")
  @@index([installedAt(sort: Desc)], map: "pwa_installations_installed_at_idx")
  @@index([platform], map: "pwa_installations_platform_idx")
  @@map("pwa_installations")
}

model MemberNotification {
  id        String   @id @default(uuid())
  memberId  String   @map("member_id")
  type      String   // 'renewal_approved' | 'renewal_rejected' | 'transaction_recorded' | 'expiring_soon' | 'welcome' | 'system'
  titleBn   String   @map("title_bn")
  titleEn   String   @map("title_en")
  messageBn String   @map("message_bn")
  messageEn String   @map("message_en")
  isRead    Boolean  @default(false) @map("is_read")
  link      String?  @map("link")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId], map: "member_notifications_member_id_idx")
  @@index([memberId, isRead], map: "member_notifications_member_is_read_idx")
  @@index([createdAt(sort: Desc)], map: "member_notifications_created_at_idx")
  @@map("member_notifications")
}

model AdminUser {
  id          String    @id
  name        String
  email       String    @unique
  phone       String?   @unique
  password    String
  role        String    @default("super_admin") // 'super_admin' | 'content_moderator' | 'support_staff'
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([role], map: "admin_users_role_idx")
  @@index([isActive], map: "admin_users_is_active_idx")
  @@map("admin_users")
}

model DatabaseSnapshot {
  id          String    @id @default(uuid())
  name        String
  description String?
  format      String    // 'json' | 'sql'
  fileSize    Int       @map("file_size") // size in bytes
  tableStats  String    @map("table_stats") // JSON string of record counts per table
  dataPayload String?   @map("data_payload") // Stored backup payload for server-side snapshots
  trigger     String    @default("manual") // 'manual' | 'automated'
  createdBy   String?   @map("created_by") // Admin name / email
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz

  @@index([createdAt(sort: Desc)], map: "database_snapshots_created_at_idx")
  @@map("database_snapshots")
}

model Review {
  id            String    @id @default(uuid())
  memberId      String    @map("member_id")
  partnerId     String    @map("partner_id")
  rating        Int       // 1 to 5
  comment       String?   @db.Text
  status        String    @default("pending") // 'pending' | 'approved' | 'rejected'
  adminFeedback String?   @map("admin_feedback") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  partner       Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId], map: "reviews_partner_id_idx")
  @@index([memberId], map: "reviews_member_id_idx")
  @@index([status], map: "reviews_status_idx")
  @@index([partnerId, status], map: "reviews_partner_id_status_idx")
  @@index([createdAt(sort: Desc)], map: "reviews_created_at_idx")
  @@map("reviews")
}

